import { Palette, Label, GlassPanel } from "components.slint";

// Small building blocks for the card-style Manage page and the Wi-Fi
// repeater preview.

export component Toggle inherits Rectangle {
    in property <bool> on;
    width: 40px; height: 22px; border-radius: 11px;
    background: root.on ? Palette.accent : Palette.line;
    Rectangle {
        x: root.on ? parent.width - 20px : 2px; y: 2px; width: 18px; height: 18px;
        border-radius: 9px; background: #ffffff;
    }
}

// A coloured rounded square with a white outline icon (24x24 path).
export component SettingIcon inherits Rectangle {
    in property <string> glyph;
    in property <color> tint;
    width: 28px; height: 28px; border-radius: 8px; background: root.tint;
    Path {
        x: 5px; y: 5px; width: 18px; height: 18px; viewbox-width: 24; viewbox-height: 24;
        commands: root.glyph; fill: transparent;
        stroke: #ffffff; stroke-width: 2.2px; stroke-line-cap: round; stroke-line-join: round;
    }
}

// One tile of the two-column grid: optional icon, title, optional subtitle,
// and either a switch showing the current state or a chevron.
export component SettingTile inherits GlassPanel {
    in property <string> title;
    in property <string> subtitle;
    in property <string> icon;
    in property <color> tint: Palette.accent;
    // -1 = no switch, 0 = off, 1 = on. The tile opens its page either way.
    in property <int> toggle: -1;
    in property <bool> chevron;
    callback clicked;
    translucent: true; height: 56px; horizontal-stretch: 1; min-width: 0px;
    property <length> text-x: root.icon != "" ? 46px : 12px;
    property <length> right-w: root.toggle >= 0 ? 50px : root.chevron ? 20px : 0px;
    if root.icon != "": SettingIcon { x: 11px; y: (parent.height - 28px) / 2; glyph: root.icon; tint: root.tint; }
    Label {
        x: root.text-x; y: root.subtitle == "" ? 0px : 8px;
        width: parent.width - root.text-x - root.right-w - 6px; height: root.subtitle == "" ? parent.height : 21px;
        text: root.title; font-size: 14px; font-weight: 600; vertical-alignment: center;
    }
    if root.subtitle != "": Label {
        x: root.text-x; y: 29px; width: parent.width - root.text-x - root.right-w - 6px; height: 18px;
        text: root.subtitle; font-size: 12px; color: Palette.muted; vertical-alignment: center;
    }
    if root.toggle >= 0: Toggle { x: parent.width - 50px; y: (parent.height - 22px) / 2; on: root.toggle == 1; }
    if root.chevron && root.toggle < 0: Label {
        x: parent.width - 20px; y: 0px; width: 12px; height: parent.height;
        text: "›"; font-size: 20px; color: Palette.muted; vertical-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}
