import { Palette, Label, TapButton, AmbientBackground, GlassPanel } from "components.slint";
import { StatusBar } from "status.slint";

// A ring gauge: track, optional arc (fraction 0..1; below 0 draws the track
// only), a value in the middle and a caption underneath.
export component Ring inherits Rectangle {
    in property <float> fraction: -1;
    in property <string> value;
    in property <length> value-size: 16px;
    in property <string> caption;
    in property <color> tint: Palette.accent-ink;
    width: 92px; height: 94px;
    Path {
        x: (parent.width - 66px) / 2; y: 0px; width: 66px; height: 66px; viewbox-width: 66; viewbox-height: 66;
        commands: "M 33 4 A 29 29 0 1 1 32.99 4";
        stroke: Palette.line; stroke-width: 5px;
    }
    if root.fraction > 0.005: Path {
        x: (parent.width - 66px) / 2; y: 0px; width: 66px; height: 66px; viewbox-width: 66; viewbox-height: 66;
        commands: root.fraction >= 0.995 ? "M 33 4 A 29 29 0 1 1 32.99 4"
            : "M 33 4 A 29 29 0 " + (root.fraction > 0.5 ? "1" : "0") + " 1 " + (33 + sin(root.fraction * 360deg) * 29) + " " + (33 - cos(root.fraction * 360deg) * 29);
        stroke: root.tint; stroke-width: 5px; stroke-line-cap: round;
    }
    Label {
        x: (parent.width - 56px) / 2; y: 0px; width: 56px; height: 66px;
        text: root.value; font-size: root.value-size; font-weight: 650;
        horizontal-alignment: center; vertical-alignment: center;
    }
    Label {
        x: 0px; y: 70px; width: parent.width; height: 22px;
        text: root.caption; font-size: 13px; color: Palette.text;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

export component LockScreen inherits AmbientBackground {
    in property <bool> airplane;
    in property <string> profile;
    in property <string> profile-label;
    in property <bool> thermal;
    in property <bool> rail;
    in property <bool> pin-enabled;
    in property <bool> awake: true;
    in property <float> progress;
    in property <string> clock;
    in property <string> date;
    in property <string> battery;
    in property <int> battery-level;
    in property <bool> charging;
    in property <bool> external-power;
    in property <bool> bypass-power;
    in property <bool> wifi-enabled;
    in property <string> power-label;
    in property <string> network-badge;
    in property <int> signal-level;
    in property <string> connection-label;
    in property <string> network-mode;
    in property <string> carrier-label;
    in property <string> client-count;
    in property <bool> network-online;
    // 0 = unknown, 1 = weak, 2 = fair, 3 = good.
    in property <int> signal-quality;
    in property <string> primary-band;
    in property <int> memory-percent: -1;
    in property <string> month-data;
    in property <float> month-fraction: -1;
    in property <string> download;
    in property <string> upload;
    in property <string> download-path;
    in property <string> upload-path;
    in property <int> samples;
    callback hold-start;
    callback hold-tick;
    callback hold-end(bool);
    callback hold-cancel;
    // Swipe up (at least 90 px) anywhere below the status bar to unlock; a
    // PIN, when set, is still asked for afterwards.
    callback swipe-unlock;
    // A double tap anywhere on the lock screen (status bar included) turns the
    // screen off, same as a short power-key press.
    callback sleep-now;
    background: Palette.bg;
    pure function level-color(level: int) -> color {
        return level >= 3 ? Palette.good : level == 2 ? Palette.warning : level == 1 ? Palette.bad : Palette.accent-ink;
    }
    // How far the current touch has moved up, for the swipe hint.
    property <length> lift: touch.pressed && root.awake ? min(max(touch.pressed-y - touch.mouse-y, 0px), 120px) : 0px;
    property <bool> dragged;
    lock-tap-window := Timer {
        interval: 400ms;
        running: false;
        triggered => { self.running = false; }
    }
    // Bottom layer: blocks touches from reaching the home page beneath, takes
    // the swipe, and turns two quick taps into "screen off".
    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { root.dragged = false; }
            if event.kind == PointerEventKind.up && root.awake && self.pressed-y - self.mouse-y >= 90px {
                lock-tap-window.running = false;
                root.swipe-unlock();
            }
        }
        moved => {
            if self.mouse-y - self.pressed-y > 12px || self.pressed-y - self.mouse-y > 12px
                || self.mouse-x - self.pressed-x > 12px || self.pressed-x - self.mouse-x > 12px {
                root.dragged = true;
            }
        }
        clicked => {
            if root.awake && !root.dragged {
                if lock-tap-window.running {
                    lock-tap-window.running = false;
                    root.sleep-now();
                } else {
                    lock-tap-window.running = true;
                }
            }
        }
    }
    StatusBar {
        x: 0px; y: 0px; width: parent.width; awake: root.awake; locked: true;
        double-tap-enabled: root.awake;
        double-tapped => { root.sleep-now(); }
        connection: root.connection-label; network: root.network-badge; signal-level: root.signal-level;
        wifi-enabled: root.wifi-enabled;
        battery: root.battery; battery-level: root.battery-level;
        charging: root.charging; external-power: root.external-power; bypass-power: root.bypass-power;
        power-label: root.power-label; airplane: root.airplane; profile: root.profile; thermal: root.thermal; rail: root.rail;
    }
    Label {
        x: 24px; y: 36px - root.lift * 0.3; width: parent.width - 48px; height: 22px;
        text: root.date; font-size: 15px; color: Palette.muted; horizontal-alignment: center; vertical-alignment: center;
    }
    Label {
        x: 16px; y: 56px - root.lift * 0.3; width: parent.width - 32px; height: 78px;
        text: root.clock; font-size: 70px; font-weight: 600; letter-spacing: -1px;
        horizontal-alignment: center; vertical-alignment: center;
    }
    HorizontalLayout {
        x: 12px; y: 144px - root.lift * 0.3; width: parent.width - 24px; height: 94px;
        alignment: space-between;
        Ring {
            fraction: root.memory-percent >= 0 ? root.memory-percent / 100.0 : -1;
            value: root.memory-percent >= 0 ? root.memory-percent + "%" : "—";
            caption: @tr("内存"); tint: Palette.dark ? #b59cff : #6d4bd8;
        }
        Ring {
            fraction: root.signal-level > 0 ? root.signal-level / 4.0 : -1;
            value: root.airplane ? "—" : root.network-badge == "" ? "—" : root.network-badge;
            value-size: 18px;
            caption: root.airplane ? @tr("飞行模式") : root.primary-band == "" ? root.carrier-label : root.carrier-label + " " + root.primary-band;
            tint: root.level-color(root.signal-quality);
        }
        Ring {
            fraction: root.month-fraction;
            value: root.month-data == "" ? "—" : root.month-data;
            value-size: 13px;
            caption: @tr("本月流量"); tint: Palette.dark ? #5ec4ff : #0b7bc0;
        }
    }
    GlassPanel {
        x: 14px; y: 248px - root.lift * 0.3; width: parent.width - 28px; height: 116px; translucent: true;
        Label { x: 14px; y: 10px; width: 130px; height: 18px; text: @tr("↓ 下载"); font-size: 13px; color: Palette.muted; }
        Label { x: parent.width - 144px; y: 10px; width: 130px; height: 18px; text: @tr("↑ 上传"); font-size: 13px; color: Palette.muted; horizontal-alignment: right; }
        HorizontalLayout {
            x: 14px; y: 28px; width: 160px; height: 42px; spacing: 4px; alignment: start;
            Label { text: root.download; font-size: 34px; font-weight: 650; color: Palette.accent-ink; vertical-alignment: bottom; }
            Label { text: "Mbps"; font-size: 12px; color: Palette.muted; vertical-alignment: bottom; }
        }
        HorizontalLayout {
            x: parent.width - 134px; y: 28px; width: 120px; height: 42px; spacing: 4px; alignment: end;
            Label { text: root.upload; font-size: 26px; font-weight: 650; color: Palette.warning; vertical-alignment: bottom; }
            Label { text: "Mbps"; font-size: 12px; color: Palette.muted; vertical-alignment: bottom; }
        }
        Rectangle {
            x: 14px; y: 76px; width: parent.width - 28px; height: 32px; clip: true;
            Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Palette.line; }
            if !root.airplane && root.download-path != "": Path {
                width: parent.width; height: parent.height; commands: root.download-path;
                viewbox-width: 272; viewbox-height: 54; fit: fill;
                stroke: Palette.accent-ink; stroke-width: 1.6px; stroke-line-cap: round; stroke-line-join: round;
            }
            if !root.airplane && root.upload-path != "": Path {
                width: parent.width; height: parent.height; commands: root.upload-path;
                viewbox-width: 272; viewbox-height: 54; fit: fill;
                stroke: Palette.warning; stroke-width: 1.4px; stroke-line-cap: round; stroke-line-join: round;
            }
            if root.airplane || root.samples < 2: Label {
                width: parent.width; height: parent.height;
                text: root.airplane ? @tr("蜂窝流量已暂停") : @tr("正在积累趋势"); font-size: 12px; color: Palette.muted; horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }
    HorizontalLayout {
        x: 16px; y: 374px - root.lift * 0.3; width: parent.width - 32px; height: 22px; spacing: 6px; alignment: center;
        Rectangle {
            width: 8px;
            Rectangle {
                y: 7px; width: 8px; height: 8px; border-radius: 4px;
                background: !root.network-online ? Palette.warning : root.signal-quality > 0 ? root.level-color(root.signal-quality) : Palette.good;
            }
        }
        Label {
            text: (root.airplane ? (root.wifi-enabled ? @tr("Wi-Fi 可用") : @tr("蜂窝网络已关闭"))
                : !root.network-online ? @tr("未联网")
                : root.signal-quality >= 3 ? @tr("信号良好")
                : root.signal-quality == 2 ? @tr("信号一般")
                : root.signal-quality == 1 ? @tr("信号较弱")
                : @tr("已联网"))
                + " · " + @tr("{0} 台设备", root.client-count) + " · " + root.battery;
            font-size: 13px; color: Palette.muted; vertical-alignment: center;
        }
    }
    // Swipe hint; it follows the finger up and lights when far enough.
    Rectangle {
        x: (parent.width - self.width) / 2; y: 418px - root.lift; width: hint.preferred-width + 52px; height: 38px;
        border-radius: 19px; border-width: 1px; border-color: Palette.rim;
        background: root.lift >= 90px ? Palette.accent : Palette.glass;
        Path {
            x: 16px; y: 13px; width: 14px; height: 10px; viewbox-width: 14; viewbox-height: 10;
            commands: "M 1 8 L 7 2 L 13 8";
            stroke: root.lift >= 90px ? Palette.accent-on : Palette.text; stroke-width: 2px; stroke-line-cap: round; stroke-line-join: round;
        }
        hint := Label {
            x: 38px; y: 0px; width: self.preferred-width; height: parent.height;
            text: root.lift >= 90px ? @tr("松开继续") : @tr("上滑解锁");
            font-size: 14px; font-weight: 600; vertical-alignment: center;
            color: root.lift >= 90px ? Palette.accent-on : Palette.text;
        }
    }
    if root.pin-enabled: Label {
        x: 16px; y: 458px; width: parent.width - 32px; height: 18px;
        text: @tr("查看设置与操作需要密码"); font-size: 11px; color: Palette.muted; horizontal-alignment: center;
    }
}

export component PinPad inherits AmbientBackground {
    in property <string> title;
    in property <string> message;
    in property <string> masked;
    in property <bool> busy;
    in property <int> remaining;
    callback digit(int);
    callback backspace;
    callback submit;
    callback cancel;
    background: Palette.bg;
    TouchArea { }
    Label { x: 16px; y: 30px; width: parent.width - 32px; height: 36px; text: root.title; font-size: 22px; font-weight: 600; horizontal-alignment: center; }
    Label { x: 20px; y: 76px; width: parent.width - 40px; height: 44px; text: root.remaining > 0 ? root.remaining + @tr(" 秒后可以重试") : root.message; font-size: 14px; color: Palette.muted; horizontal-alignment: center; wrap: word-wrap; }
    Label { x: 16px; y: 126px; width: parent.width - 32px; height: 36px; text: root.masked == "" ? "—" : root.masked; font-size: 21px; color: Palette.accent-ink; horizontal-alignment: center; letter-spacing: 2px; }
    for digit in [1,2,3,4,5,6,7,8,9]: TapButton {
        x: 16px + mod(digit - 1, 3) * 100px;
        y: 180px + floor((digit - 1) / 3) * 58px;
        width: 88px; height: 50px; text: "" + digit; text-size: 24px;
        interactive: !root.busy && root.remaining == 0;
        clicked => { root.digit(digit); }
    }
    TapButton { x: 16px; y: 354px; width: 88px; height: 50px; text: @tr("删除"); interactive: !root.busy; clicked => { root.backspace(); } }
    TapButton { x: 116px; y: 354px; width: 88px; height: 50px; text: "0"; text-size: 24px; interactive: !root.busy && root.remaining == 0; clicked => { root.digit(0); } }
    TapButton { x: 216px; y: 354px; width: 88px; height: 50px; text: root.busy ? @tr("处理中") : @tr("确认"); selected: true; interactive: !root.busy && root.remaining == 0; clicked => { root.submit(); } }
    TapButton { x: 16px; y: 424px; width: 288px; height: 44px; text: @tr("取消"); clicked => { root.cancel(); } }
}
